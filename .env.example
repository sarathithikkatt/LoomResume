# ==============================================================================
# LoomResume - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust the values according to your local environment.

# ------------------------------------------------------------------------------
# Database Settings (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=loom_resume
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:password@localhost:5432/loom_resume

# ------------------------------------------------------------------------------
# Application & Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# LLM Provider Configuration (LiteLLM)
# ------------------------------------------------------------------------------
# Default provider and model to use for chat, refraction, and agents.
# Options: ollama/llama3.1:8b, gpt-4o, claude-3-5-sonnet-20241022, grok-beta, etc.
LLM_DEFAULT_PROVIDER=ollama
LLM_DEFAULT_MODEL=ollama/llama3.1:8b
OLLAMA_API_BASE=http://localhost:11434

# Optional: Cloud LLM API Keys (uncomment and populate if using OpenAI or Anthropic)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------------------------
# Embedding Model Configuration
# ------------------------------------------------------------------------------
# Provider: "auto" (defaults to Ollama if local, otherwise OpenAI), "ollama", or "openai"
EMBEDDING_PROVIDER=auto
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# ------------------------------------------------------------------------------
# Optional LangChain Tracing (LangSmith)
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
